# Скопируйте в .env и заполните. .env в .gitignore — никогда не коммитьте.

# Anthropic API — обязателен для scripts/ai_review.py и LLM-вызовов
ANTHROPIC_API_KEY=sk-ant-...

# Опционально: переопределяет модель ревьюера в CI (дефолт claude-haiku-4-5)
# REVIEW_MODEL=claude-sonnet-4-5

# Опционально: лимит размера diff для ревью в символах (дефолт 120000)
# MAX_DIFF_CHARS=120000
